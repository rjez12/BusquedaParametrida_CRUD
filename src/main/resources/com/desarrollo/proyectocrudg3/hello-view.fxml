<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>

<AnchorPane prefHeight="651.0"
            prefWidth="700.0"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.desarrollo.proyectocrudg3.controller.ProductosController">

    <children>

        <Label layoutX="14.0"
               layoutY="22.0"
               text="Gestión de Productos">
            <font>
                <Font name="System Bold Italic" size="23.0"/>
            </font>
        </Label>

        <VBox layoutX="14.0"
              layoutY="56.0"
              prefWidth="63.0"
              spacing="10.0">
            <children>
                <Label text="Código:"/>
                <Label text="Precio:"/>
                <Label text="Categoría:"/>
                <Label text="Fecha:"/>
            </children>
        </VBox>

        <VBox layoutX="77.0"
              layoutY="50.0"
              prefWidth="167.0"
              spacing="5.0">
            <children>
                <TextField fx:id="txtCodigo"
                           promptText="Código del producto"/>

                <TextField fx:id="txtPrecio"
                           promptText="Ejemplo: 12500.00"/>

                <ComboBox fx:id="cmbCategoria"
                          prefWidth="167.0"
                          promptText="Selecciona categoría"/>

                <DatePicker fx:id="dpFecha"
                            prefWidth="167.0"
                            disable="true"
                            promptText="Fecha automática"/>
            </children>
        </VBox>

        <VBox layoutX="274.0"
              layoutY="56.0"
              prefWidth="80.0"
              spacing="10.0">
            <children>
                <Label text="Nombre:"/>
                <Label text="Stock:"/>
                <Label text="Marca:"/>
                <Label text="Descripción:"/>
            </children>
        </VBox>

        <VBox layoutX="354.0"
              layoutY="50.0"
              prefWidth="167.0"
              spacing="5.0">
            <children>
                <TextField fx:id="txtNombre"
                           promptText="Nombre del producto"/>

                <TextField fx:id="txtStock"
                           promptText="Cantidad"/>

                <ComboBox fx:id="cmbMarca"
                          prefWidth="167.0"
                          promptText="Selecciona marca"/>

                <TextField fx:id="txtDescripcion"
                           promptText="Descripción opcional"/>
            </children>
        </VBox>

        <HBox layoutX="14.0"
              layoutY="173.0"
              spacing="5.0">
            <children>
                <Button fx:id="btnNuevo"
                        text="Nuevo"
                        mnemonicParsing="false"
                        onAction="#limpiarFormulario"/>

                <Button fx:id="btnGuardar"
                        text="Guardar"
                        mnemonicParsing="false"
                        onAction="#guardarProducto"/>

                <Button fx:id="btnActualizar"
                        text="Actualizar"
                        mnemonicParsing="false"
                        onAction="#actualizarProducto"/>

                <Button fx:id="btnEliminar"
                        text="Eliminar"
                        mnemonicParsing="false"
                        onAction="#eliminarProducto"/>
            </children>
        </HBox>

        <Line layoutX="14.0"
              layoutY="207.0"
              startX="0.0"
              endX="653.0"/>

        <Label layoutX="14.0"
               layoutY="215.0"
               text="Búsqueda y filtros">
            <font>
                <Font name="System Bold Italic" size="19.0"/>
            </font>
        </Label>

        <VBox layoutX="14.0"
              layoutY="253.0"
              prefWidth="100.0"
              spacing="10.0">
            <children>
                <Label text="Código o nombre:"/>
                <Label text="Desde:"/>
                <Label text="Precio mínimo:"/>
            </children>
        </VBox>

        <VBox layoutX="114.0"
              layoutY="247.0"
              prefWidth="161.0"
              spacing="5.0">
            <children>
                <TextField fx:id="txtBusqueda"
                           promptText="Buscar producto"
                           onAction="#buscarProductos"/>

                <DatePicker fx:id="dpDesde"
                            prefWidth="161.0"/>

                <TextField fx:id="txtPrecioMinimo"
                           promptText="Precio mínimo"/>
            </children>
        </VBox>

        <VBox layoutX="287.0"
              layoutY="253.0"
              prefWidth="100.0"
              spacing="10.0">
            <children>
                <Label text="Categoría:"/>
                <Label text="Hasta:"/>
                <Label text="Precio máximo:"/>
                <Label text="Ordenar por:"/>
            </children>
        </VBox>

        <VBox layoutX="387.0"
              layoutY="247.0"
              prefWidth="180.0"
              spacing="5.0">
            <children>
                <ComboBox fx:id="cmbFiltroCategoria"
                          prefWidth="180.0"
                          promptText="Todas las categorías"/>

                <DatePicker fx:id="dpHasta"
                            prefWidth="180.0"/>

                <TextField fx:id="txtPrecioMaximo"
                           promptText="Precio máximo"/>

                <ComboBox fx:id="cmbOrdenar"
                          prefWidth="180.0"
                          promptText="Selecciona orden"/>
            </children>
        </VBox>

        <CheckBox fx:id="chkExistencias"
                  layoutX="14.0"
                  layoutY="345.0"
                  mnemonicParsing="false"
                  text="Solo productos con existencias"/>

        <Button fx:id="btnBuscar"
                layoutX="14.0"
                layoutY="375.0"
                mnemonicParsing="false"
                text="Buscar"
                onAction="#buscarProductos"/>

        <Button fx:id="btnLimpiarFiltros"
                layoutX="75.0"
                layoutY="375.0"
                mnemonicParsing="false"
                text="Limpiar filtros"
                onAction="#limpiarFiltros"/>

        <TableView fx:id="tblProductos"
                   layoutX="14.0"
                   layoutY="411.0"
                   prefHeight="200.0"
                   prefWidth="653.0">

            <columns>
                <TableColumn fx:id="colCodigo"
                             prefWidth="75.0"
                             text="Código"/>

                <TableColumn fx:id="colNombre"
                             prefWidth="150.0"
                             text="Nombre"/>

                <TableColumn fx:id="colCategoria"
                             prefWidth="95.0"
                             text="Categoría"/>

                <TableColumn fx:id="colMarca"
                             prefWidth="80.0"
                             text="Marca"/>

                <TableColumn fx:id="colPrecio"
                             prefWidth="80.0"
                             text="Precio"/>

                <TableColumn fx:id="colStock"
                             prefWidth="55.0"
                             text="Stock"/>

                <TableColumn fx:id="colFecha"
                             prefWidth="115.0"
                             text="Fecha creación"/>
            </columns>

        </TableView>

    </children>
</AnchorPane>